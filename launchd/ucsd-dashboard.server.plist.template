<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.ucsd-dashboard.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>scripts/dashboard_server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <!-- Keeps the dashboard and its Refresh button available at http://127.0.0.1:8765. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/dashboard_server.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/dashboard_server.log</string>
</dict>
</plist>
