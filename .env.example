# Canvas calendar feed (required).
# Canvas > Calendar > "Calendar Feed" (bottom right) > copy the URL.
# Treat it like a password. Anyone with this link can read your calendar.
CANVAS_ICAL_URL=

# More feeds, such as a community college (optional).
# Add each one to config/dashboard.yaml under "sources".
# CANVAS_ICAL_URL_COMMUNITY_COLLEGE=

# Used when the Google Calendar sync runs.
TIMEZONE=America/Los_Angeles
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Optional: Google Calendar sync (python -m src.main). See the README.
# ---------------------------------------------------------------------------
# CANVAS_API_URL=https://canvas.ucsd.edu
# CANVAS_API_TOKEN=
# ANTHROPIC_API_KEY=
# GOOGLE_CALENDAR_ID=primary
# SYNC_DAYS_AHEAD=90
# SYNC_DAYS_BEHIND=7
